import java.util.Arrays;

class Solution {
    public int sortableIntegers(int[] nums) {
        int n = nums.length;
        int[] prefMax = new int[n + 1];
        prefMax[0] = 0;
        for (int i = 0; i < n; i++) {
            prefMax[i + 1] = Math.max(prefMax[i], nums[i]);
        }
        
        int[] suffMin = new int[n + 1];
        suffMin[n] = Integer.MAX_VALUE;
        for (int i = n - 1; i >= 0; i--) {
            suffMin[i] = Math.min(nums[i], suffMin[i + 1]);
        }
      
        int[] dropCount = new int[n + 1];
        for (int i = 1; i < n; i++) {
            dropCount[i] = dropCount[i - 1] + (nums[i - 1] > nums[i] ? 1 : 0);
        }
        
        int totalSum = 0;
        
        for (int k = 1; k <= n; k++) {
            if (n % k != 0) {
                continue;
            }
            
            boolean isValid = true;
            int prevMax = Integer.MIN_VALUE;
            
            for (int i = 0; i < n; i += k) {
                int left = i;
                int right = i + k - 1;
                int internalDrops = 0;
                if (left < right) {
                    internalDrops = countDrops(dropCount, left + 1, right);
                  
                    if (nums[right] > nums[left]) {
                        internalDrops++;
                    }
                }
                
                if (internalDrops > 1) {
                    isValid = false;
                    break;
                }
            
                int bMin = getBlockMin(nums, left, right);
                int bMax = getBlockMax(nums, left, right);
                
                if (bMin < prevMax) {
                    isValid = false;
                    break;
                }
                prevMax = bMax;
            }
            
            if (isValid) {
                totalSum += k;
            }
        }
        
        return totalSum;
    }
    
    private int countDrops(int[] dropCount, int l, int r) {
        if (l > r) return 0;
        return dropCount[r] - dropCount[l - 1];
    }
    
    private int getBlockMin(int[] nums, int l, int r) {
        int min = nums[l];
        for (int i = l + 1; i <= r; i++) {
            min = Math.min(min, nums[i]);
        }
        return min;
    }
    
    private int getBlockMax(int[] nums, int l, int r) {
        int max = nums[l];
        for (int i = l + 1; i <= r; i++) {
            max = Math.max(max, nums[i]);
        }
        return max;
    }
}
