
class Solution {
    static final int MOD = 1_000_000_007;
    public int sumCounts(int[] nums) {
        int n = nums.length;
        long[] sum = new long[4 * n];
        long[] sumSq = new long[4 * n];
        long[] lazy = new long[4 * n];
        int[] last = new int[100001];
        java.util.Arrays.fill(last, -1);
        long ans = 0;
        for (int i = 0; i < n; i++) {
            int left = last[nums[i]] + 1;
            int right = i;
            update(1, 0, n - 1, left, right,sum, sumSq, lazy);
            last[nums[i]] = i;
            ans = (ans + sumSq[1]) % MOD;
        }
        return (int) ans;
    }
    private void update(int node, int start, int end, int left, int right, long[] sum,long[] sumSq, long[] lazy) {
        if (left > end || right < start) {
            return;
        }
        if (left <= start && end <= right) {
            apply(node, start, end, sum, sumSq, lazy);
            return;
        }
        push(node, start, end, sum, sumSq, lazy);
        int mid = start + (end - start) / 2;
        update(node * 2, start, mid, left, right,sum, sumSq, lazy);
        update(node * 2 + 1, mid + 1, end, left, right,sum, sumSq, lazy);
        sum[node] = (sum[node * 2] + sum[node * 2 + 1]) % MOD;
        sumSq[node] = (sumSq[node * 2] + sumSq[node * 2 + 1]) % MOD;
    }
    private void apply(int node, int start, int end,long[] sum, long[] sumSq, long[] lazy) {
        long len = end - start + 1L;
        long oldSum = sum[node];
        long inc = lazy[node] + 1;
        sumSq[node] = (sumSq[node]+ 2L * oldSum % MOD+ len) % MOD;
        sum[node] = (oldSum + len) % MOD;
        lazy[node] = (lazy[node] + 1) % MOD;
    }
    private void push(int node, int start, int end,long[] sum, long[] sumSq, long[] lazy) {
        if (lazy[node] == 0 || start == end) {
            return;
        }
        int mid = start + (end - start) / 2;
        int leftChild = node * 2;
        int rightChild = node * 2 + 1;
        applyLazy(leftChild, mid - start + 1L,lazy[node], sum, sumSq, lazy);
        applyLazy(rightChild, end - mid,lazy[node], sum, sumSq, lazy);
        lazy[node] = 0;
    }
    private void applyLazy(int node, long len, long add,long[] sum, long[] sumSq, long[] lazy) {
        long oldSum = sum[node];
        sumSq[node] = (sumSq[node]+ 2L * add % MOD * oldSum % MOD+ len * add % MOD * add % MOD) % MOD;
        sum[node] = (oldSum + len * add) % MOD;
        lazy[node] = (lazy[node] + add) % MOD;
    }
}
