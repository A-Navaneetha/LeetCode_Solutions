class Solution {
    static class Node {
        int[] remain = new int[5];
        int prod = 1;
    }
    static class SegmentTree {
        private final int n;
        private final int k;
        private final Node[] tree;
        public SegmentTree(int[] nums, int k) {
            this.n = nums.length;
            this.k = k;
            this.tree = new Node[4 * n];
            for (int i = 0; i < tree.length; i++) {
                tree[i] = new Node();
            }
            build(nums, 0, 0, n - 1);
        }
        private Node merge(Node left, Node right) {
            Node node = new Node();
            node.prod = (left.prod * right.prod) % k;
            for (int r = 0; r < k; r++) {
                node.remain[r] += left.remain[r];
            }
            for (int r = 0; r < k; r++) {
                int newRem = (r * left.prod) % k;
                node.remain[newRem] += right.remain[r];
            }
            return node;
        }
        private void build(int[] nums, int treeIndex, int lo, int hi) {
            if (lo == hi) {
                int val = nums[lo] % k;
                tree[treeIndex].remain[val] = 1;
                tree[treeIndex].prod = val;
                return;
            }
            int mid = lo + (hi - lo) / 2;
            build(nums, 2 * treeIndex + 1, lo, mid);
            build(nums, 2 * treeIndex + 2, mid + 1, hi);
            tree[treeIndex] = merge(tree[2 * treeIndex + 1], tree[2 * treeIndex + 2]);
        }
        public void update(int index, int val) {
            update(0, 0, n - 1, index, val % k);
        }
        private void update(int treeIndex, int lo, int hi, int i, int val) {
            if (lo == hi) {
                for (int r = 0; r < k; r++) {
                    tree[treeIndex].remain[r] = 0;
                }
                tree[treeIndex].remain[val] = 1;
                tree[treeIndex].prod = val;
                return;
            }
            int mid = lo + (hi - lo) / 2;
            if (i <= mid) {
                update(2 * treeIndex + 1, lo, mid, i, val);
            } else {
                update(2 * treeIndex + 2, mid + 1, hi, i, val);
            }
            tree[treeIndex] = merge(tree[2 * treeIndex + 1], tree[2 * treeIndex + 2]);
        }
        public Node query(int ql, int qr) {
            return query(0, 0, n - 1, ql, qr);
        }
        private Node query(int treeIndex, int lo, int hi, int ql, int qr) {
            if (ql <= lo && hi <= qr) {
                return tree[treeIndex];
            }
            int mid = lo + (hi - lo) / 2;
            if (qr <= mid) {
                return query(2 * treeIndex + 1, lo, mid, ql, qr);
            }
            if (ql > mid) {
                return query(2 * treeIndex + 2, mid + 1, hi, ql, qr);
            }
            Node leftNode = query(2 * treeIndex + 1, lo, mid, ql, qr);
            Node rightNode = query(2 * treeIndex + 2, mid + 1, hi, ql, qr);
            return merge(leftNode, rightNode);
        }
    }
    public int[] resultArray(int[] nums, int k, int[][] queries) {
        SegmentTree tree = new SegmentTree(nums, k);
        int[] res = new int[queries.length];
        for (int i = 0; i < queries.length; i++) {
            int index = queries[i][0];
            int val = queries[i][1];
            int start = queries[i][2];
            int x = queries[i][3];
            tree.update(index, val);
            Node resNode = tree.query(start, nums.length - 1);
            res[i] = resNode.remain[x];
        }
        return res;
    }
}
