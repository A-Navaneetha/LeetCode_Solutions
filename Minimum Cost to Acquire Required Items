class Solution {
    public long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        long commonNeeded = Math.min((long) need1, (long) need2);
        long rem1 = (long) need1 - commonNeeded;
        long rem2 = (long) need2 - commonNeeded;

        long commonCost = commonNeeded * Math.min((long) costBoth, (long) cost1 + cost2);

        long rem1Cost = rem1 * Math.min((long) cost1, (long) costBoth);
        long rem2Cost = rem2 * Math.min((long) cost2, (long) costBoth);

        return commonCost + rem1Cost + rem2Cost;
    }
}
