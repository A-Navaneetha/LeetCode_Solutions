class Solution {
    public int uniquePaths(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int MOD = 1_000_000_007;

        int[][][] jump = new int[m][n][2];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                jump[i][j][0] = getLanding(grid, i, j, 0, 1);
                jump[i][j][1] = getLanding(grid, i, j, 1, 0);
            }
        }

        long[][] dp = new long[m][n];
        dp[0][0] = 1;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (dp[i][j] == 0) continue;

                int nextRight = jump[i][j][0];
                if (nextRight != -1) {
                    int r = nextRight / n;
                    int c = nextRight % n;
                    dp[r][c] = (dp[r][c] + dp[i][j]) % MOD;
                }

                int nextDown = jump[i][j][1];
                if (nextDown != -1) {
                    int r = nextDown / n;
                    int c = nextDown % n;
                    dp[r][c] = (dp[r][c] + dp[i][j]) % MOD;
                }
            }
        }

        return (int) dp[m - 1][n - 1];
    }

    private int getLanding(int[][] grid, int r, int c, int dr, int dc) {
        int m = grid.length;
        int n = grid[0].length;

        int curR = r + dr;
        int curC = c + dc;
        int moveDir = (dc == 1) ? 0 : 1;

        while (true) {
            if (curR < 0 || curR >= m || curC < 0 || curC >= n) {
                return -1;
            }
            if (grid[curR][curC] == 0) {
                return curR * n + curC;
            }
            if (moveDir == 0) {
                dr = 1;
                dc = 0;
                moveDir = 1;
            } else {
                dr = 0;
                dc = 1;
                moveDir = 0;
            }
            curR += dr;
            curC += dc;
        }
    }
}
