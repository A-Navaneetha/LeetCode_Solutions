class Solution {
    public int maxSum(List<Integer> nums, int k) {
        int[] bitCount = new int[32];
        for (int num : nums) {
            for (int i = 0; i < 32; i++) {
                if ((num & (1 << i)) != 0) {
                    bitCount[i]++;
                }
            }
        }
        long mod = 1_000_000_007;
        long Sum = 0;
        for (int i = 0; i < k; i++) {
            long currNum = 0;
            for (int bit = 0; bit < 32; bit++) {
                if (bitCount[bit] > 0) {
                    currNum |= (1L << bit);
                    bitCount[bit]--;
                }
            }
            Sum = (Sum + (currNum * currNum) % mod) % mod;
        }
        return (int) Sum;
    }
}
