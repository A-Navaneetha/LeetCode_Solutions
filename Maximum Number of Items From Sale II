import java.util.Arrays;

class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;
        int[] freq = new int[n + 1];
        int minPrice = Integer.MAX_VALUE;

        for (int[] item : items) {
            freq[item[0]]++;
            if (item[1] < minPrice) {
                minPrice = item[1];
            }
        }

        int[] multiplesCount = new int[n + 1];
        for (int f = 1; f <= n; f++) {
            if (freq[f] == 0) continue;
            for (int m = f; m <= n; m += f) {
                multiplesCount[f] += freq[m];
            }
        }

        int[][] enriched = new int[n][2];
        for (int i = 0; i < n; i++) {
            int f = items[i][0];
            int p = items[i][1];
            enriched[i][0] = p;
            enriched[i][1] = multiplesCount[f] - 1;
        }

        Arrays.sort(enriched, (a, b) -> Integer.compare(a[0], b[0]));

        long totalItems = 0;
        long remBudget = budget;

        for (int[] item : enriched) {
            long price = item[0];
            long gain = item[1];

            if (price >= 2L * minPrice) {
                break;
            }
            if (gain <= 0) {
                continue;
            }

            long canBuy = Math.min(gain, remBudget / price);
            totalItems += canBuy * 2;
            remBudget -= canBuy * price;
        }

        totalItems += remBudget / minPrice;
        return (int) totalItems;
    }
}
