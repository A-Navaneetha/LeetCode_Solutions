class Solution {
    public int reverseDegree(String s) {
        int Sum = 0;
        for (int i = 0; i < s.length(); i++) {
            int revAlphabetPos = 26 - (s.charAt(i) - 'a');
            int stringPos = i + 1;
            Sum += revAlphabetPos * stringPos;
        }
        return Sum;
    }
}
