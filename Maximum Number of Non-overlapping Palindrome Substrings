class Solution {
    public int maxPalindromes(String s, int k) {
        int c = 0;
        int n = s.length();
        int lastEnd = -1; 
        for (int i = 0; i < n; i++) {
            for (int len = k; len <= k + 1; len++) {
                int start = i - len / 2;
                int end = start + len - 1;
                if (len % 2 == 0) {
                    start = i - len / 2 + 1;
                    end = i + len / 2;
                }
                if (start > lastEnd && isPalindrome(s, start, end)) {
                    c++;
                    lastEnd = end;
                    break; 
                }
            }
        }
        return c;
    }
    private boolean isPalindrome(String s, int start, int end) {
        if (start < 0 || end >= s.length()) return false;
        while (start < end) {
            if (s.charAt(start) != s.charAt(end)) return false;
            start++;
            end--;
        }
        return true;
    }
}
