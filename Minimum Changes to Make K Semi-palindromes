class Solution {
    private Integer[][] memoCost;
    private Integer[][] memoDp;
    private String s;
    private int n;

    public int minimumChanges(String s, int k) {
        this.s = s;
        this.n = s.length();
        this.memoCost = new Integer[n][n];
        this.memoDp = new Integer[n][k + 1];
        
        return solveDp(0, k);
    }

    private int solveDp(int idx, int kLeft) {
        if (kLeft == 1) {
            return getCost(idx, n - 1);
        }
        if (n - idx < kLeft * 2) {
            return 1000000;
        }
        if (memoDp[idx][kLeft] != null) {
            return memoDp[idx][kLeft];
        }

        int minChanges = 1000000;
        for (int end = idx + 1; end <= n - (kLeft - 1) * 2 - 1; end++) {
            int currentCost = getCost(idx, end);
            int remainingCost = solveDp(end + 1, kLeft - 1);
            minChanges = Math.min(minChanges, currentCost + remainingCost);
        }

        return memoDp[idx][kLeft] = minChanges;
    }

    private int getCost(int i, int j) {
        int len = j - i + 1;
        if (len == 1) {
            return 1000000;
        }
        if (memoCost[i][j] != null) {
            return memoCost[i][j];
        }

        int minChanges = 1000000;

        for (int d = 1; d < len; d++) {
            if (len % d == 0) {
                int changes = 0;
                for (int st = 0; st < d; st++) {
                    int l = i + st;
                    int r = i + (len - d) + st;
                    while (l < r) {
                        if (s.charAt(l) != s.charAt(r)) {
                            changes++;
                        }
                        l += d;
                        r -= d;
                    }
                }
                minChanges = Math.min(minChanges, changes);
            }
        }

        return memoCost[i][j] = minChanges;
    }
}
